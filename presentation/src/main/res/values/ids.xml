<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tags used by View.applyInsetPadding / applyInsetBottomMargin to remember a view's original
         padding/margin, so repeated window-inset passes (rotation, IME) never accumulate. -->
    <item name="insetBasePadding" type="id" />
    <item name="insetBaseMargin" type="id" />
    <item name="insetBaseHeight" type="id" />
    <!-- Marks a view BaseActivity.extendBehindNavigationBar has laid out around the navigation bar -->
    <item name="navigationBarInset" type="id" />
    <!-- Whether a button at the end of the compose bar is shown or on its way to be, see swapShown -->
    <item name="swapShown" type="id" />
</resources>
