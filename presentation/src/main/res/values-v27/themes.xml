<resources>

    <!-- Splash screen: light mode on Oreo+ gets light status/nav bar icons -->
    <style name="AppLaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:navigationBarColor">@color/backgroundLight</item>
        <item name="android:statusBarColor">@color/backgroundLight</item>
        <item name="android:windowBackground">@color/backgroundLight</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- On Oreo+, background-matching status and navigation bars -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="android:navigationBarColor">@color/backgroundLight</item>
        <item name="android:statusBarColor">@color/backgroundLight</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
