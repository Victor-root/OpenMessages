<!--
    Recipient chip shown in the compose header while editing recipients. It is intentionally styled to
    match an existing conversation's title (plain text on the colored toolbar, no bubble box and no
    avatar) so a new conversation's header looks identical to an existing one. The chip stays tappable:
    tapping it opens the detailed chip to remove the recipient. Because it lives inside the Toolbar's
    ThemeOverlay.AppCompat.Dark.ActionBar, ?android:attr/textColorPrimary resolves to white here, which
    is what we want on the colored header.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <io.openmessages.common.widget.QkTextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        app:textSize="toolbar"
        tools:text="Moez Bhatti"
        android:textDirection="ltr" />

</RelativeLayout>
