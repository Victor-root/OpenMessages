<?xml version="1.0" encoding="utf-8"?>
<!-- The actions of a dialog on one line however narrow the screen: deleting as an icon on the left,
     cancelling and saving on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/button_delete"
        android:padding="8dp"
        android:src="@drawable/ic_delete_white_24dp" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/cancel"
        style="@style/DialogTextButton"
        android:text="@string/button_cancel" />

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/save"
        style="@style/DialogTextButton"
        android:layout_marginStart="8dp"
        android:background="@drawable/rounded_rectangle_22dp"
        android:foreground="@drawable/rounded_ripple_20dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/button_save" />

</LinearLayout>
