<!-- A participant at the top of the conversation menu: who they are, adding them as a contact
     when they aren't one, and their colour -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <io.openmessages.common.widget.AvatarView
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <io.openmessages.common.widget.AppTextView
            android:id="@+id/name"
            style="@style/TextPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Moez Bhatti" />

        <io.openmessages.common.widget.AppTextView
            android:id="@+id/address"
            style="@style/TextSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="(123) 456-7890" />

    </LinearLayout>

    <ImageView
        android:id="@+id/add"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_person_add_black_24dp"
        app:tint="?android:attr/textColorSecondary" />

    <ImageView
        android:id="@+id/theme"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/title_theme"
        android:padding="8dp"
        android:src="@drawable/ic_palette_black_24dp"
        app:tint="?android:attr/textColorSecondary" />

</LinearLayout>
