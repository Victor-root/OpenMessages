<!-- A message waiting to be sent, shown after the conversation's real messages. Deliberately close
     to message_list_item_out so it reads as one of the user's own, but faded and captioned with its
     send time so it is never mistaken for a message that has already gone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">

        <io.openmessages.common.widget.TightTextView
            android:id="@+id/body"
            style="@style/TextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:alpha="0.65"
            android:background="@drawable/message_only"
            android:backgroundTint="?attr/bubbleColor"
            android:gravity="start|center_vertical"
            android:minHeight="36dp"
            tools:text="Message programmé" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_schedule_send_black_24dp"
                app:tint="?android:attr/textColorSecondary" />

            <io.openmessages.common.widget.QkTextView
                android:id="@+id/scheduledAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="?android:attr/textColorSecondary"
                app:textSize="tertiary"
                tools:text="Envoi prévu à 21:48" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
