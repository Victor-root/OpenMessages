<!-- Volume row shown above the Cancel/OK buttons in the send-sound QkDialog (set as its
     extraView). The SeekBar's progress/thumb tint placeholder here is design-time only; the real
     theme color is applied in code when the dialog is built, same as elsewhere in the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_round_volume_up_24"
        app:tint="?android:attr/textColorSecondary" />

    <SeekBar
        android:id="@+id/volume"
        style="@style/Widget.AppCompat.SeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:contentDescription="@string/settings_send_sound_volume_title"
        android:max="100"
        android:progressTint="@color/tools_theme"
        android:thumbTint="@color/tools_theme" />

</LinearLayout>
