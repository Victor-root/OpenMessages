<!-- Cancel/OK row for QkDialog's confirmWithButtons mode. A custom row instead of the stock
     AlertDialog buttons, which are tinted from the app's static theme and don't follow the
     user's chosen theme color (see TextInputDialog for the same reasoning). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingBottom="8dp"
    android:paddingEnd="8dp">

    <io.openmessages.common.widget.QkTextView
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="16dp"
        android:text="@string/button_cancel"
        android:textStyle="bold"
        app:textColor="theme"
        app:textSize="secondary" />

    <io.openmessages.common.widget.QkTextView
        android:id="@+id/ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackground"
        android:padding="16dp"
        android:text="@android:string/ok"
        android:textStyle="bold"
        app:textColor="theme"
        app:textSize="secondary" />

</LinearLayout>
