<!-- Hours or minutes of a time, stepped up and down with the arrows around them -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/up"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/compose_schedule_increase"
        android:padding="8dp"
        android:src="@drawable/ic_keyboard_arrow_up_black_24dp" />

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/value"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:background="@drawable/rounded_rectangle_22dp"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="32sp"
        tools:text="08" />

    <ImageView
        android:id="@+id/down"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/compose_schedule_decrease"
        android:padding="8dp"
        android:src="@drawable/ic_keyboard_arrow_down_black_24dp" />

</LinearLayout>
