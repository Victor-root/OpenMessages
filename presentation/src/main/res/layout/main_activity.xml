<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            android:background="?android:attr/windowBackground">

            <!-- The toolbar and the search row laid over it, collapsing together -->
            <FrameLayout
                android:id="@+id/toolbarFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|enterAlways|snap">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    style="@style/Toolbar"
                    android:animateLayoutChanges="true"
                    app:contentInsetStartWithNavigation="0dp">

                    <LinearLayout
                        android:id="@+id/toolbarLogoGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <!-- Written as AukDialer writes its titles: the system font, bold, 22sp -->
                        <TextView
                            android:id="@+id/toolbarTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/toolbarSearchIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/title_search"
                        android:padding="12dp"
                        android:src="@drawable/ic_search_outline"
                        android:visibility="gone"
                        app:tint="@color/white" />

                    <FrameLayout
                        android:id="@+id/toolbarUnreadBadge"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/toolbarUnreadIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tabler_mail_filled"
                            android:contentDescription="@null"
                            app:tint="@color/white" />

                        <io.openmessages.common.widget.AppTextView
                            android:id="@+id/toolbarUnreadCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/badge_count"
                            android:gravity="center"
                            android:minWidth="16dp"
                            android:minHeight="16dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="3" />

                    </FrameLayout>

                </androidx.appcompat.widget.Toolbar>

                <!--
                    The search row, laid over the whole toolbar on the toolbar's own background. It is
                    unrolled from the right edge and rolled back the same way, as in AukDialer.
                -->
                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/searchBack"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/main_search_close_cd"
                        android:padding="16dp"
                        android:src="@drawable/ic_chevron_back_24dp"
                        app:tint="@color/white" />

                    <io.openmessages.common.widget.AppEditText
                        android:id="@+id/toolbarSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/title_conversations"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/white"
                        android:textColorHint="#B3FFFFFF"
                        android:nextFocusRight="@+id/compose"
                        app:textSize="primary"
                        tools:textSize="16sp" />

                    <ImageView
                        android:id="@+id/searchClear"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/main_search_clear_cd"
                        android:padding="12dp"
                        android:src="@drawable/ic_close_black_24dp"
                        android:visibility="invisible"
                        app:tint="@color/white" />

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <io.openmessages.common.widget.AppTextView
                android:id="@+id/empty"
                style="@style/TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="56dp"
                app:layout_constraintBottom_toTopOf="@id/bottom"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Your conversations will appear here"
                tools:visibility="invisible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="88dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toTopOf="@id/bottom"
                app:layout_constraintTop_toTopOf="parent"
                tools:listitem="@layout/conversation_list_item" />

            <View
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/divider"
                app:layout_constraintBottom_toTopOf="@id/snackbar" />

            <ViewStub
                android:id="@+id/snackbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inflatedId="@id/snackbar"
                android:layout="@layout/main_permission_hint"
                app:layout_constraintBottom_toTopOf="@id/syncing" />

            <ViewStub
                android:id="@+id/syncing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inflatedId="@id/syncing"
                android:layout="@layout/main_syncing"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--
            FAB lives directly in CoordinatorLayout, NOT inside the scrolling ConstraintLayout.
            ScrollingViewBehavior lays ConstraintLayout out as (CoordinatorLayout.height + AppBarLayout.height)
            so the ConstraintLayout bottom deliberately extends past CoordinatorLayout bounds.
            Any view constrained to that bottom would be hidden below the nav bar when the toolbar
            is visible. CoordinatorLayout itself is always bounded correctly above the nav bar.
        -->
        <ImageView
            android:id="@+id/scrollToTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="80dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/circle"
            android:contentDescription="@null"
            android:elevation="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard_arrow_up_black_24dp"
            android:visibility="gone"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/compose"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/rounded_rect_16dp"
            android:contentDescription="@string/main_fab_cd"
            android:elevation="8dp"
            android:padding="14dp"
            android:src="@drawable/ic_add_black_24dp"
            app:tint="@color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/drawer"
        layout="@layout/drawer_view"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
