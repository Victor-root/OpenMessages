<!-- A conversation in the list, laid out as Google Messages lists them: flat and edge to edge, the
     time above an unread count on the right -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:nextFocusRight="@+id/compose"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <io.openmessages.common.widget.GroupAvatarView
        android:id="@+id/avatars"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ringColor="?android:attr/windowBackground" />

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/title"
        style="@style/TextPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:lines="1"
        android:textDirection="ltr"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@id/snippet"
        app:layout_constraintEnd_toStartOf="@id/date"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/avatars"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="@tools:sample/full_names" />

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/snippet"
        style="@style/TextSecondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pinned"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="@tools:sample/lorem/random" />

    <ImageView
        android:id="@+id/pinned"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_baseline_push_pin_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/snippet"
        app:layout_constraintEnd_toStartOf="@id/scheduled"
        app:layout_constraintTop_toTopOf="@id/snippet"
        app:tint="?android:attr/textColorTertiary"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/scheduled"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_event_black_24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/snippet"
        app:layout_constraintEnd_toStartOf="@id/unread"
        app:layout_constraintTop_toTopOf="@id/snippet"
        app:tint="?android:attr/textColorTertiary"
        tools:visibility="visible" />

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/unread"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:background="@drawable/rounded_rect_20dp"
        android:gravity="center"
        android:minWidth="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/snippet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/snippet"
        tools:backgroundTint="@color/tools_theme"
        tools:text="3"
        tools:textColor="@android:color/white"
        tools:visibility="visible" />

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/date"
        style="@style/TextTertiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="18:45" />

</androidx.constraintlayout.widget.ConstraintLayout>
