<?xml version="1.0" encoding="utf-8"?>
<!-- Template editor, in a Material 3 dialog: a heading, two outlined fields and its actions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <io.openmessages.common.widget.AppTextView
        android:id="@+id/heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="24sp"
        tools:text="@string/template_new" />

    <io.openmessages.common.widget.AppEditText
        android:id="@+id/titleField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/template_title_hint"
        android:inputType="textCapSentences"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:singleLine="true"
        app:textSize="primary" />

    <io.openmessages.common.widget.AppEditText
        android:id="@+id/field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="top|start"
        android:hint="@string/template_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="8"
        android:minLines="4"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:scrollbars="vertical"
        app:textSize="primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <io.openmessages.common.widget.AppTextView
            android:id="@+id/delete"
            style="@style/DialogTextButton"
            android:text="@string/button_delete" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <io.openmessages.common.widget.AppTextView
            android:id="@+id/cancel"
            style="@style/DialogTextButton"
            android:text="@string/button_cancel" />

        <io.openmessages.common.widget.AppTextView
            android:id="@+id/save"
            style="@style/DialogTextButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_rectangle_22dp"
            android:foreground="@drawable/rounded_ripple_20dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/button_save" />

    </LinearLayout>

</LinearLayout>
