<resources>

    <!-- Splash screen in system dark mode -->
    <style name="AppLaunchTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:navigationBarColor">@color/backgroundDark</item>
        <item name="android:statusBarColor">@color/backgroundDark</item>
        <item name="android:windowBackground">@color/backgroundDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Dark mode base theme: dark backgrounds, dark bubble, dark ripple -->
    <style name="AppBaseTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:divider">@color/separatorDark</item>
        <item name="android:queryBackground">@color/bubbleDark</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowBackground">@color/backgroundDark</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="actionBarPopupTheme">@style/PopupTheme.Black</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="bubbleColor">@color/bubbleDark</item>
        <item name="colorAccent">@color/colorBrand</item>
        <item name="colorPrimary">@color/backgroundDark</item>
        <item name="colorPrimaryDark">@color/backgroundDark</item>
        <item name="selectableItemBackground">@drawable/ripple_dark</item>
        <item name="switchThumbEnabled">@color/switchThumbEnabledDark</item>
        <item name="switchThumbDisabled">@color/switchThumbDisabledDark</item>
        <item name="switchTrackEnabled">@color/switchTrackEnabledDark</item>
        <item name="switchTrackDisabled">@color/switchTrackDisabledDark</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Dark variant of the rounded alert dialog (windowBackground resolves to drawable-night). -->
    <style name="AlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="colorAccent">@color/colorBrand</item>
        <item name="android:textColorPrimary">@color/textPrimaryDark</item>
        <item name="android:textColorSecondary">@color/textSecondaryDark</item>
    </style>

    <style name="PopupTheme.Black" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">@color/backgroundDark</item>
        <item name="android:textColor">@color/textPrimaryDark</item>
    </style>

    <!--
        Pure-black ("AMOLED") variant of the dark theme, selected by getActivityThemeRes() when the
        user turns on pure-black mode. It turns the dark-grey background surfaces true black to save
        power on OLED screens; the accent colour and the status/navigation bars are applied live in
        QkThemedActivity, so only the background surfaces need overriding here.
    -->
    <style name="AppTheme.Black">
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
    </style>

</resources>
