<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded top corners for the compose attachment sheet. windowBackground follows the active
     theme (light / dark / black), so the sheet always matches the conversation behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp" />

    <solid android:color="?android:attr/windowBackground" />

</shape>
