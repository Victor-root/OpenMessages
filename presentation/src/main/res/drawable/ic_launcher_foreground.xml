<!--
    Adaptive-icon foreground layer: 108×108dp canvas, safe zone 18–90dp.
    The icon (24×24 SVG coordinates) is scaled ×2.4 (→ 57.6dp) and centered,
    leaving generous background margin around the bubble (matching the look of
    the reference icon) rather than filling the whole safe zone.
    translate = (108 − 24×2.4) / 2 = 25.2 to keep it centered.
    Source: Tabler Icons / icon-tabler-message (filled variant), MIT licence.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="25.2"
        android:translateY="25.2">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,3a4,4 0,0,1 4,4v8a4,4 0,0,1 -4,4h-4.724l-4.762,2.857a1,1 0,0,1 -1.508,-0.743l-0.006,-0.114v-2h-1a4,4 0,0,1 -3.995,-3.8l-0.005,-0.2v-8a4,4 0,0,1 4,-4zM14,12h-6a1,1 0,0,0 0,2h6a1,1 0,0,0 0,-2M16,8h-8a1,1 0,1,0 0,2h8a1,1 0,0,0 0,-2" />
    </group>

</vector>
